platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting Flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

def invoke_generated_pod_scripts_with_system_shell(project)
  direct_generated_script = /^("\$\{PODS_ROOT\}\/Target Support Files\/[^"\n]+\.sh")$/

  project.targets.each do |target|
    target.shell_script_build_phases.each do |phase|
      next unless phase.shell_script

      phase.shell_script = phase.shell_script.gsub(
        direct_generated_script,
        '/bin/sh \1',
      )
    end
  end
end

target 'Runner' do
  # Firebase의 바이너리 의존성을 Runner에 정적으로 링크한다. SwiftPM의 동적
  # XCFramework는 공급자 dSYM이 없어 App Store Connect 심볼 경고를 발생시킨다.
  use_frameworks! :linkage => :static

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      # Xcode 26 no longer accepts the legacy deployment targets declared by
      # some transitive pods. The app supports iOS 13+, so align every pod.
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'

      # Keep third-party deprecation diagnostics out of release logs while
      # preserving warnings from the Runner target and application sources.
      config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
      config.build_settings['SWIFT_SUPPRESS_WARNINGS'] = 'YES'
    end
  end

  # Xcode normally executes CocoaPods-generated helper scripts directly.
  # macOS can misclassify those local scripts when the project directory has
  # downloaded-file provenance and terminate them with `Killed: 9`. Passing
  # them to the trusted system shell avoids that false-positive execution path
  # without removing security metadata from downloaded pod binaries.
  invoke_generated_pod_scripts_with_system_shell(installer.pods_project)
end

post_integrate do |installer|
  installer.aggregate_targets
    .map(&:user_project)
    .compact
    .uniq
    .each do |project|
      invoke_generated_pod_scripts_with_system_shell(project)
      project.save
  end
end
